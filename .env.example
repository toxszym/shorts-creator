# Copy to .env and fill in what you need. The API (apps/api) loads this file on start.
# Variables already set in the shell take precedence.

# --- Script writer -----------------------------------------------------------
# Setting an Anthropic key makes Claude write scripts through the API.
ANTHROPIC_API_KEY=
# Alternative to the API key, e.g. for a gateway:
# ANTHROPIC_AUTH_TOKEN=
# ANTHROPIC_BASE_URL=

# Without a key: "cli" uses the locally installed Claude Code (`claude -p`),
# "off" disables the model even when a key is set. Leave empty to fall back
# to the prepared scripts in samples/.
KRONIKA_WRITER=

# --- API server --------------------------------------------------------------
# PORT=4000
# Project directory with assets/, data/ and out/. Defaults to the repo root.
# KRONIKA_ROOT=

# --- Web app -----------------------------------------------------------------
# Not read from this file: Next.js loads env files from apps/web/, and the value
# is fixed at build time. Set it in apps/web/.env.local only if the API is not
# on http://localhost:4000.
# NEXT_PUBLIC_API=http://localhost:4000
